---
/** Icono de feriado irrenunciable. SVG inline: son 2 iconos en todo el sitio,
    no justifica cargar una fuente de iconos. */
interface Props { titulo?: string }
const { titulo = 'Feriado irrenunciable' } = Astro.props;
---
<span class="candado" title={titulo}>
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M12 1a5 5 0 0 0-5 5v3H6a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-9a2 2 0 0 0-2-2h-1V6a5 5 0 0 0-5-5Zm3 8H9V6a3 3 0 1 1 6 0v3Z"/>
  </svg>
  <span class="oculto-visualmente">{titulo}</span>
</span>
