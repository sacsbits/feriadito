---
/** Shell mínimo para las rutas de imágenes sociales. No se indexan: existen
    solo para que Puppeteer las capture en el post-build. */
import '@fontsource-variable/plus-jakarta-sans';
import '../styles/global.css';
---
<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Imagen social</title>
    <!--
      `is:inline` es obligatorio acá: sin él estos estilos entran al bundle CSS
      global (cssCodeSplit está desactivado) y, como Astro no puede scopear
      selectores `body`, se aplicarían al sitio entero.
      Ya pasó una vez: un `body { display: inline-block }` encogió el body en
      todas las páginas y rompió el centrado del layout.
    -->
    <style is:inline>
      html, body { margin: 0; padding: 0; background: #fff; }
    </style>
  </head>
  <body><slot /></body>
</html>
