---
import TarjetaOG from '../../components/TarjetaOG.astro';
import LayoutOG from '../../layouts/LayoutOG.astro';
import { proximoFeriado } from '../../lib/feriados.ts';
import { diasEntre, fechaLargaConAnio, hoyEnChile, textoContador } from '../../lib/fecha.ts';

// Formato pedido por querystring: ?f=ig para el vertical de Instagram
const formato = Astro.url.searchParams.get('f');
const ig = formato === 'ig';

const hoy = hoyEnChile();
const proximo = proximoFeriado(hoy)!;
const dias = diasEntre(hoy, proximo.fecha);
const { encabezado, pie } = textoContador(dias);
const esHoy = dias === 0;
---
<LayoutOG>
  <TarjetaOG
    ancho={ig ? 1080 : 1200}
    alto={ig ? 1350 : 630}
    encabezado={esHoy ? undefined : encabezado}
    numero={esHoy ? undefined : String(Math.abs(dias))}
    pie={esHoy ? undefined : `${pie} el próximo feriado`}
    etiqueta={esHoy ? '🎉 Hoy es feriado' : undefined}
    titular={proximo.nombre}
    fecha={fechaLargaConAnio(proximo.fecha)}
  />
</LayoutOG>
